# Copy this file to .env and fill in real values. Never commit .env.

# Password for the admin panel at /admin. Required. Pick something long.
ADMIN_PASSWORD=

# Optional: where ads.json and uploaded images/videos are stored.
# Defaults to server/data. On a host whose filesystem resets on each deploy
# (like Render), point this at a persistent disk, e.g. /var/data
# DATA_DIR=

# Left over from the waiver kiosk. The ad screen doesn't send email, but
# these are kept in case you want notifications later.
RESEND_API_KEY=
FROM_EMAIL=
TO_EMAIL=

PORT=3000
